DEBUG=True
FORCE_SCRIPT_NAME=
# Required. Generate your own, don't reuse this or any value committed to git:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
# Kinopoli integration: session pushes for the venue power control. Leave
# empty to disable. The token is the same value as Kinopoli's HIFIPIIKKI_TOKEN.
# Production: KINOPOLI_PUSH_URL=http://127.0.0.1:8082/hifipiikki/session
KINOPOLI_PUSH_URL=
KINOPOLI_TOKEN=
# Extra hosts to accept, comma separated. Production needs 172.17.0.1 so the
# Kinopoli container can read the session state directly.
EXTRA_ALLOWED_HOSTS=
